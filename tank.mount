#/etc/systemd/system/tank.mount
[Unit]
Description=Mount NFS Tank
After=network-online.target
Wants=network-online.target

[Mount]
What=host:/tank
Where=/var/tank
Type=nfs
Options=_netdev,defaults,x-systemd.automount,x-systemd.idle-timeout=1min,nofail
TimeoutSec=3
ForceUnmount=yes

[Install]
WantedBy=multi-user.target
